{
  "name": "devflow-ai",
  "version": "0.0.0",
  "private": true,
  "description": "DevFlow AI: a language-agnostic, evidence-driven AI software engineering workflow framework.",
  "license": "Apache-2.0",
  "author": "Mohamed Yangui <mohamed.yangui@esprit.tn>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedyangui/DevFlow.git"
  },
  "homepage": "https://github.com/mohamedyangui/DevFlow#readme",
  "bugs": {
    "url": "https://github.com/mohamedyangui/DevFlow/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "devflow": {
    "npmScope": "@devflow",
    "packageBoundaries": {
      "core": [],
      "context": [
        "core"
      ],
      "ai": [
        "core"
      ],
      "adapter-java": [
        "core"
      ],
      "adapter-javascript": [
        "core"
      ],
      "adapter-python": [
        "core"
      ],
      "github": [
        "core"
      ],
      "contracts": [
        "core"
      ],
      "workflow": [
        "core",
        "context",
        "ai",
        "contracts"
      ],
      "cli": "*"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:examples": "node scripts/test-examples.mjs",
    "schemas:generate": "node scripts/generate-schemas.mjs",
    "scope:rename": "node scripts/rename-scope.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@devflow/adapter-java": "workspace:*",
    "@devflow/adapter-javascript": "workspace:*",
    "@devflow/adapter-python": "workspace:*",
    "@devflow/cli": "workspace:*",
    "@devflow/context": "workspace:*",
    "@devflow/core": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
