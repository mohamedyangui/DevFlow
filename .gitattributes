# Normalize text files to LF in the repository and the working tree.
* text=auto eol=lf

# Windows batch files must keep CRLF line endings to run correctly (e.g. mvnw.cmd, gradlew.bat).
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.wasm binary
