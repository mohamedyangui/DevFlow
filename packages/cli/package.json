{
  "name": "@devflowai/cli",
  "version": "0.2.0",
  "private": true,
  "description": "DevFlow AI command-line interface (the `devflow` command).",
  "license": "Apache-2.0",
  "author": "Mohamed Yangui <mohamed.yangui@esprit.tn>",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
