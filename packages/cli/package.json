    "@devflowai/context": "workspace:*",
    "@devflowai/contracts": "workspace:*",
    "@devflowai/core": "workspace:*",
    "@devflowai/github": "workspace:*",
    "@devflowai/mcp": "workspace:*",
    "@devflowai/workflow": "workspace:*",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1"
  }
}
